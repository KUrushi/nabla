;;;; 最小の JSON リーダ / ライタ（safetensors のヘッダ専用。issue #198）。
;;;;
;;;; 扱うのは、オブジェクト・配列・文字列・整数・true / false / null だけ。
;;;; 小数・指数の数値は safetensors のヘッダに現れないので、読むとエラーにする。
;;;; オブジェクトは (:object (キー . 値)...)（出現順。空の {} と [] を区別するため
;;;; 先頭に :object を置く）、配列はリスト、
;;;; true / false / null は :true / :false / :null。重複するキーはエラー。
;;;; 外部の JSON ライブラリ（cl-yason）を使わない理由は safetensors.lisp の冒頭を参照。

(in-package #:nabla.nn)

(define-condition %json-syntax-error (error)
  ((message :initarg :message :reader %json-syntax-error-message))
  (:report (lambda (c s) (write-string (%json-syntax-error-message c) s))))

(defun %json-fail (control &rest args)
  (error '%json-syntax-error :message (apply #'format nil control args)))

(defparameter +json-max-depth+ 64
  "配列・オブジェクトの入れ子の深さの上限（壊れたヘッダでスタックを使い切らないため）。")

(defun %ascii-digit-p (char &optional (radix 10))
  "CHAR が ASCII の RADIX 進の数字なら真（Unicode の他の数字は受け付けない）。"
  (and (< (char-code char) 128) (digit-char-p char radix)))

(defun %json-parse (text)
  "TEXT（文字列）を JSON として読み、上のデータ表現で返す。構文が不正なら
%json-syntax-error。"
  (let ((pos 0) (end (length text)) (depth 0))
    (labels ((peek () (if (< pos end) (char text pos) (%json-fail "JSON が途中で終わっている")))
             (next () (prog1 (peek) (incf pos)))
             (skip-space ()
               (loop while (and (< pos end) (member (char text pos) '(#\Space #\Tab #\Newline #\Return)))
                     do (incf pos)))
             (expect (char)
               (let ((c (next)))
                 (unless (char= c char) (%json-fail "~S を期待したが ~S だった" char c))))
             (literal (word value)
               (loop for c across word do (expect c))
               value)
             (hex4 ()
               (when (> (+ pos 4) end) (%json-fail "\\u エスケープが途中で終わっている"))
               (let ((digits (subseq text pos (+ pos 4))))
                 (unless (every (lambda (c) (%ascii-digit-p c 16)) digits)
                   (%json-fail "\\u エスケープが不正"))
                 (incf pos 4)
                 (parse-integer digits :radix 16)))
             (parse-escape (out)
               (let ((e (next)))
                 (case e
                   ((#\" #\\ #\/) (write-char e out))
                   (#\b (write-char #\Backspace out))
                   (#\f (write-char #\Page out))
                   (#\n (write-char #\Newline out))
                   (#\r (write-char #\Return out))
                   (#\t (write-char #\Tab out))
                   (#\u
                    (let ((code (hex4)))
                      (when (<= #xD800 code #xDBFF)
                        (unless (and (< (1+ pos) end)
                                     (char= (char text pos) #\\)
                                     (char= (char text (1+ pos)) #\u))
                          (%json-fail "上位サロゲートの後に下位サロゲートが無い"))
                        (incf pos 2)
                        (let ((low (hex4)))
                          (unless (<= #xDC00 low #xDFFF)
                            (%json-fail "下位サロゲートが不正"))
                          (setf code (+ #x10000 (ash (- code #xD800) 10) (- low #xDC00)))))
                      (when (<= #xDC00 code #xDFFF)
                        (%json-fail "対の無い下位サロゲート"))
                      (write-char (code-char code) out)))
                   (t (%json-fail "不明なエスケープ \\~A" e)))))
             (parse-string ()
               (expect #\")
               (with-output-to-string (out)
                 (loop
                   (let ((c (next)))
                     (cond
                       ((char= c #\") (return))
                       ((char< c #\Space) (%json-fail "文字列に制御文字がある"))
                       ((char= c #\\) (parse-escape out))
                       (t (write-char c out)))))))
             (parse-integer-value ()
               (let ((start pos))
                 (when (char= (peek) #\-) (incf pos))
                 (unless (%ascii-digit-p (peek)) (%json-fail "数値に数字が無い"))
                 (when (and (char= (peek) #\0) (< (1+ pos) end) (%ascii-digit-p (char text (1+ pos))))
                   (%json-fail "数値の先頭に不要な 0 がある"))
                 (loop while (and (< pos end) (%ascii-digit-p (char text pos))) do (incf pos))
                 (when (and (< pos end) (find (char text pos) ".eE"))
                   (%json-fail "整数以外の数値は扱わない"))
                 (parse-integer text :start start :end pos)))
             (nested (parser)
               (when (> (incf depth) +json-max-depth+)
                 (%json-fail "入れ子が深すぎる"))
               (incf pos)
               (prog1 (funcall parser) (decf depth)))
             (parse-value ()
               (skip-space)
               (case (peek)
                 (#\{ (nested #'parse-object))
                 (#\[ (nested #'parse-array))
                 (#\" (parse-string))
                 (#\t (literal "true" :true))
                 (#\f (literal "false" :false))
                 (#\n (literal "null" :null))
                 (t (if (or (char= (peek) #\-) (%ascii-digit-p (peek)))
                        (parse-integer-value)
                        (%json-fail "予期しない文字 ~S" (peek))))))
             (parse-array ()
               (skip-space)
               (if (char= (peek) #\])
                   (progn (incf pos) nil)
                   (loop collect (parse-value)
                         do (skip-space)
                            (case (next)
                              (#\, nil)
                              (#\] (loop-finish))
                              (t (%json-fail "配列の , か ] が無い"))))))
             (parse-object ()
               (skip-space)
               (if (char= (peek) #\})
                   (progn (incf pos) (list :object))
                   (let ((members '()))
                     (loop
                       (skip-space)
                       (let ((key (parse-string)))
                         (when (assoc key members :test #'string=)
                           (%json-fail "オブジェクトのキー ~S が重複している" key))
                         (skip-space)
                         (expect #\:)
                         (push (cons key (parse-value)) members))
                       (skip-space)
                       (case (next)
                         (#\, nil)
                         (#\} (return))
                         (t (%json-fail "オブジェクトの , か } が無い"))))
                     (cons :object (nreverse members))))))
      (let ((value (parse-value)))
        (skip-space)
        (when (< pos end) (%json-fail "JSON の後ろに余計な文字がある"))
        value))))

(defun %json-object-p (value)
  (and (consp value) (eq (car value) :object)))

(defun %json-write-string (string stream)
  "STRING を JSON の文字列として STREAM に書く。\" \\ と制御文字だけをエスケープし、
他の文字（非 ASCII を含む）はそのまま書く。"
  (write-char #\" stream)
  (loop for c across string
        do (cond ((char= c #\") (write-string "\\\"" stream))
                 ((char= c #\\) (write-string "\\\\" stream))
                 ((char< c #\Space) (format stream "\\u~4,'0X" (char-code c)))
                 (t (write-char c stream))))
  (write-char #\" stream))
