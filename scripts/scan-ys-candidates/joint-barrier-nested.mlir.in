// 候補 (b) を一般化した「連鎖の形」の形 (d): 入れ子の scan（issue #233）。外側の本体に、ys を持つ長さ 2 の内側の
// scan があり、内側の本体に stablehlo.if がある。barrier は 2 段: 内側の本体で if の全出力と内側の ys のバッファを、
// 外側の本体で内側の while の全出力（carry と ys）と外側の ys のバッファを、それぞれ 1 つの barrier に通す。
// 外側の y_t は内側の ys（外側の ys は @L@x2x@W@）。
// race 用の形は docs/iree-repros/nested-scan-ys-if-joint-barrier-nested-race.mlir。コピーの個数を見るためのもの。
module {
  func.func @main(%h: tensor<@W@xf32>) -> (tensor<@W@xf32>, tensor<@L@x2x@W@xf32>) {
    %i0c = stablehlo.constant dense<0> : tensor<i32>
    %z = stablehlo.constant dense<0.0> : tensor<f32>
    %salt = stablehlo.constant dense<@L@> : tensor<i32>
    %i0, %zs, %u = stablehlo.optimization_barrier %i0c, %z, %salt : tensor<i32>, tensor<f32>, tensor<i32>
    %yb = stablehlo.broadcast_in_dim %zs, dims = [] : (tensor<f32>) -> tensor<@L@x2x@W@xf32>
    %y0 = stablehlo.optimization_barrier %yb : tensor<@L@x2x@W@xf32>
    %n, %c, %ys = "stablehlo.while"(%i0, %h, %y0) ({
    ^bb0(%ci: tensor<i32>, %cc: tensor<@W@xf32>, %cy: tensor<@L@x2x@W@xf32>):
      %len = stablehlo.constant dense<@L@> : tensor<i32>
      %lt = stablehlo.compare LT, %ci, %len : (tensor<i32>, tensor<i32>) -> tensor<i1>
      stablehlo.return %lt : tensor<i1>
    }, {
    ^bb0(%bi: tensor<i32>, %bc: tensor<@W@xf32>, %by: tensor<@L@x2x@W@xf32>):
      %zi = stablehlo.constant dense<0> : tensor<i32>
      %j0c = stablehlo.constant dense<0> : tensor<i32>
      %jz = stablehlo.constant dense<0.0> : tensor<f32>
      %jsalt = stablehlo.constant dense<2> : tensor<i32>
      %j0, %jzs, %ju = stablehlo.optimization_barrier %j0c, %jz, %jsalt : tensor<i32>, tensor<f32>, tensor<i32>
      %jyb = stablehlo.broadcast_in_dim %jzs, dims = [] : (tensor<f32>) -> tensor<2x@W@xf32>
      %jy0 = stablehlo.optimization_barrier %jyb : tensor<2x@W@xf32>
      %jn, %ic, %iys = "stablehlo.while"(%j0, %bc, %jy0) ({
      ^bb0(%ji: tensor<i32>, %jc: tensor<@W@xf32>, %jcy: tensor<2x@W@xf32>):
        %jlen = stablehlo.constant dense<2> : tensor<i32>
        %jlt = stablehlo.compare LT, %ji, %jlen : (tensor<i32>, tensor<i32>) -> tensor<i1>
        stablehlo.return %jlt : tensor<i1>
      }, {
      ^bb0(%jbi: tensor<i32>, %jbc: tensor<@W@xf32>, %jby: tensor<2x@W@xf32>):
        %jzi = stablehlo.constant dense<0> : tensor<i32>
        %half = stablehlo.constant dense<0.5> : tensor<f32>
        %init = stablehlo.constant dense<0.0> : tensor<f32>
        %sum = stablehlo.reduce(%jbc init: %init) applies stablehlo.add across dimensions = [0] : (tensor<@W@xf32>, tensor<f32>) -> tensor<f32>
        %pr = stablehlo.compare LT, %sum, %half : (tensor<f32>, tensor<f32>) -> tensor<i1>
        %t = "stablehlo.if"(%pr) ({
          %t1 = stablehlo.tanh %jbc : tensor<@W@xf32>
          stablehlo.return %t1 : tensor<@W@xf32>
        }, {
          %t2 = stablehlo.tanh %jbc : tensor<@W@xf32>
          %t3 = stablehlo.tanh %t2 : tensor<@W@xf32>
          stablehlo.return %t3 : tensor<@W@xf32>
        }) : (tensor<i1>) -> tensor<@W@xf32>
        %tb, %jbyb = stablehlo.optimization_barrier %t, %jby : tensor<@W@xf32>, tensor<2x@W@xf32>
        %ju0 = stablehlo.reshape %tb : (tensor<@W@xf32>) -> tensor<1x@W@xf32>
        %jw = stablehlo.dynamic_update_slice %jbyb, %ju0, %jbi, %jzi : (tensor<2x@W@xf32>, tensor<1x@W@xf32>, tensor<i32>, tensor<i32>) -> tensor<2x@W@xf32>
        %jone = stablehlo.constant dense<1> : tensor<i32>
        %jnext = stablehlo.add %jbi, %jone : tensor<i32>
        stablehlo.return %jnext, %tb, %jw : tensor<i32>, tensor<@W@xf32>, tensor<2x@W@xf32>
      }) : (tensor<i32>, tensor<@W@xf32>, tensor<2x@W@xf32>) -> (tensor<i32>, tensor<@W@xf32>, tensor<2x@W@xf32>)
      %icb, %iysb, %byb = stablehlo.optimization_barrier %ic, %iys, %by : tensor<@W@xf32>, tensor<2x@W@xf32>, tensor<@L@x2x@W@xf32>
      %u0 = stablehlo.reshape %iysb : (tensor<2x@W@xf32>) -> tensor<1x2x@W@xf32>
      %w = stablehlo.dynamic_update_slice %byb, %u0, %bi, %zi, %zi : (tensor<@L@x2x@W@xf32>, tensor<1x2x@W@xf32>, tensor<i32>, tensor<i32>, tensor<i32>) -> tensor<@L@x2x@W@xf32>
      %one = stablehlo.constant dense<1> : tensor<i32>
      %next = stablehlo.add %bi, %one : tensor<i32>
      stablehlo.return %next, %icb, %w : tensor<i32>, tensor<@W@xf32>, tensor<@L@x2x@W@xf32>
    }) : (tensor<i32>, tensor<@W@xf32>, tensor<@L@x2x@W@xf32>) -> (tensor<i32>, tensor<@W@xf32>, tensor<@L@x2x@W@xf32>)
    func.return %c, %ys : tensor<@W@xf32>, tensor<@L@x2x@W@xf32>
  }
}
