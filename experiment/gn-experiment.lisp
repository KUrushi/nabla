;;;; 一時的な実験（merge する前に消す）: group-norm の IREE テストを N 回流して失敗の回数を数える。
(require :asdf)
(asdf:load-system "nabla/nn/tests")
(let* ((n (parse-integer (or (uiop:getenv "GN_RUNS") "30")))
       (failures 0))
  (dotimes (i n)
    (let ((results (fiveam:run 'nabla.nn.tests::group-norm/jit-forward-and-grads-match-flax-on-iree-local)))
      (unless (fiveam:results-status results)
        (incf failures)
        (fiveam:explain! results))
      (format t "~&[gn-experiment] run ~D: ~:[FAIL~;ok~]~%" (1+ i) (fiveam:results-status results))))
  (format t "~&[gn-experiment] RESULT test-failures=~D/~D~%" failures n))
