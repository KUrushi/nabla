;;;; 一時的な実験（merge する前に消す）: layers と group-norm の IREE テストを N 回流して失敗の回数を数える。
(require :asdf)
(asdf:load-system "nabla/nn/tests")
(let* ((n (parse-integer (or (uiop:getenv "LN_RUNS") "20")))
       (failures 0))
  (dotimes (i n)
    (let ((ok (every (lambda (test)
                       (let ((results (fiveam:run test)))
                         (unless (fiveam:results-status results) (fiveam:explain! results))
                         (fiveam:results-status results)))
                     '(nabla.nn.tests::layers/jit-forward-and-grads-match-flax-on-iree-local
                       nabla.nn.tests::group-norm/jit-forward-and-grads-match-flax-on-iree-local))))
      (unless ok (incf failures))
      (format t "~&[ln-experiment] run ~D: ~:[FAIL~;ok~]~%" (1+ i) ok)))
  (format t "~&[ln-experiment] RESULT test-failures=~D/~D~%" failures n))
